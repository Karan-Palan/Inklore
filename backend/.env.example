# Server-only provider credentials. Never copy these values into the iOS app,
# Xcode scheme, Info.plist, or source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=xhigh

# ElevenLabs selection stays configurable. Multilingual v2 is the pinned
# audiobook default; replace only the voice ID when a different narrator wins.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

RESEND_API_KEY=
DIGEST_FROM_EMAIL=Inkflow <digest@inkflow.app>
CRON_SECRET=

# Asynchronous chapter video generation. ElevenLabs video flows require a
# plan/key with video access; text narration works independently.
ELEVENLABS_VIDEO_MODEL=veo-3.1-fast-generate-001
ELEVENLABS_VIDEO_RESOLUTION=720p

# Existing 10x/Neon runtime values are injected by the deployment platform.
# Use Neon's pooled connection string (`-pooler` hostname) on Vercel.
DATABASE_URL=
# Required for the directly reachable Vercel backend. Digest endpoints fail
# closed until this points at the 10x managed-auth JWKS endpoint.
TENX_AUTH_JWKS_URL=
TENX_AUTH_ISSUER=
