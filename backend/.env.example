# Server-only provider credentials. Never copy these values into the iOS app,
# Xcode scheme, Info.plist, or source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=xhigh

# ElevenLabs selection intentionally remains configurable until the hackathon
# voice and model are approved. The API defaults to Multilingual v2 if the
# model is blank, but production should pin an explicit model ID.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

RESEND_API_KEY=
DIGEST_FROM_EMAIL=ReadSync <digest@readsync.app>

# Existing 10x/Neon runtime values are injected by the deployment platform.
# Use Neon's pooled connection string (`-pooler` hostname) on Vercel.
DATABASE_URL=
# Required for the directly reachable Vercel backend. Digest endpoints fail
# closed until this points at the 10x managed-auth JWKS endpoint.
TENX_AUTH_JWKS_URL=
TENX_AUTH_ISSUER=
